# Email settings for the anonymous report form (app/api/report/route.ts).
# Copy to `.env.local` for local testing, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.

# Secret API key from https://resend.com/api-keys  (never commit the real value)
# Required before the report form can actually send anything. Note that until a
# sending domain is verified, Resend's sandbox sender (below) only delivers to
# the address that OWNS the Resend account - so create the account with
# letspolymake@gmail.com, or verify a domain and set REPORT_FROM.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives the bug reports / feedback (optional — the code defaults
# to the project inbox, letspolymake@gmail.com; set this to override it)
REPORT_TO_EMAIL=letspolymake@gmail.com

# Verified sender. Until you verify a domain in Resend, the sandbox sender
# `onboarding@resend.dev` only delivers to the Resend account owner's email.
REPORT_FROM=LetsPoly Reports <onboarding@resend.dev>

# Optional: shown in the browser as an "or email us" fallback link.
# Defaults to the project inbox; set to empty to hide the link entirely.
# The link is pre-filled with the visitor's draft + page URL, so it works even
# when RESEND_API_KEY is missing.
NEXT_PUBLIC_SUPPORT_EMAIL=letspolymake@gmail.com

# Optional: storage for the shared "anonymous love" counter
# (app/api/hearts/route.ts). Upstash Redis and Vercel KV both expose a REST API.
# Without these the heart count falls back to a per-browser counter.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash's own names work too:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
