# Email settings for the anonymous report form (app/api/report/route.ts).
# Copy to `.env.local` for local testing, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.

# Secret API key from https://resend.com/api-keys  (never commit the real value)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives the bug reports / feedback (required by the API route)
REPORT_TO_EMAIL=you@example.com

# Verified sender. Until you verify a domain in Resend, the sandbox sender
# `onboarding@resend.dev` only delivers to the Resend account owner's email.
REPORT_FROM=LetsPoly Reports <onboarding@resend.dev>

# Optional: shown in the browser as an "or email us" fallback link.
# Leave empty to hide the link entirely.
NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com
